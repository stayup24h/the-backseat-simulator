  m_Name: dialogue table_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 959018284c9a96048b626b072f4d0ec4, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 190757109802
    m_Localized: ": \uD074\uB9AC\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109803
    m_Localized: "\uC544\uBE60: \uC544\uBE60 \uC548 \uC794\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109804
    m_Localized: "\uC544\uBE60: \uBA85\uC0C1\uD558\uBA74\uC11C \uC6B4\uC804\uD558\uB294
      \uACE0\uB3C4\uC758 \uAE30\uC220\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109805
    m_Localized: "\uC5C4\uB9C8: \uC5C4\uB9C8\uB294 \uC774\uB7F4 \uB54C \uBB34\uC2A8\uB9D0\uC744
      \uD574\uC57C\uD560\uC9C0 \uBAA8\uB974\uACA0\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109806
    m_Localized: "\uB3D9\uC0DD: \uBB50"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109807
    m_Localized: ": \uADF8\uB0E5"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109808
    m_Localized: "\uB3D9\uC0DD: \uC5C4\uB9C8! \uC598\uAC00 \uAD34\uB86D\uD600"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109809
    m_Localized: "\uC5C4\uB9C8: \uB458\uC774 \uC2F8\uC6B0\uC9C0 \uB9C8~"
    m_Metadata:
      m_Items: []
  - m_Id: 190710972416
    m_Localized: "\uC5C4\uB9C8: Hi there! How can I help you today?"
    m_Metadata:
      m_Items: []
  - m_Id: 190752915456
    m_Localized: "\uC544\uBE60: Hello! I have a question about our family trip."
    m_Metadata:
      m_Items: []
  - m_Id: 190752915457
    m_Localized: "\uB3D9\uC0DD: Sure! What would you like to know?"
    m_Metadata:
      m_Items: []
  - m_Id: 190752915458
    m_Localized: "\uC5C4\uB9C8: We're planning to visit the mountains next weekend."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109760
    m_Localized: "\uC544\uBE60: That sounds exciting! Do we have everything we need
      for the trip?"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109761
    m_Localized: "\uB3D9\uC0DD: I can help pack the snacks!"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109762
    m_Localized: "\uC5C4\uB9C8: Great idea! Let's make a list of what to bring."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109763
    m_Localized: "\uC5C4\uB9C8: \uC774 \uB3C4\uB11B\uC774 \uAC1C\uBC1C\uC790\uAC00
      3\uC2DC\uAC04\uC774\uB098 \uAC78\uB824\uC11C \uB9CC\uB4E4\uC5C8\uB2E4\uACE0
      \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109764
    m_Localized: "\uC544\uBE60: \uBE14\uB80C\uB354\uB294 \uC5B4\uB835\uAD6C\uB098..."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109765
    m_Localized: "\uB3D9\uC0DD: \uBE14\uB80C\uB354\uB294 \uD29C\uD1A0\uB9AC\uC5BC
      \uBCF4\uACE0 \uB530\uB77C\uD574\uC11C \uC26C\uC6E0\uB294\uB370 \uC720\uB2C8\uD2F0\uB85C
      \uC62E\uAE30\uB294\uAC8C \uB354 \uC5B4\uB824\uC6E0\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109766
    m_Localized: "\uC5C4\uB9C8: \uADF8\uB807\uAD6C\uB098. \uADF8\uB798\uB3C4 \uB9DB\uC788\uC73C\uB2C8\uAE4C
      \uB2E4\uD589\uC774\uB124!"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109767
    m_Localized: ": \uC548\uB155"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109768
    m_Localized: "\uC544\uBE60 : \uADF8\uB798\uADF8\uB798"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109769
    m_Localized: "\uC544\uBE60: \uC751, \uB9DB\uC788\uC5B4 \uBCF4\uC5EC!"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109770
    m_Localized: "\uB3D9\uC0DD: \uB9DE\uC544, \uB2E4\uC74C\uC5D0\uB294 \uB0B4\uAC00
      \uC9C1\uC811 \uB9CC\uB4E4\uC5B4\uBCFC\uB798!"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109771
    m_Localized: ": \uC5B4\uB9B0 \uC2DC\uC808 \uCC0D\uC5C8\uB358 \uC0AC\uC9C4\uC744
      \uCC3E\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109772
    m_Localized: ": 2008\uB144 8\uC6D4, \uC5EC\uD589\uC744 \uB9C8\uCE58\uACE0 \uB3CC\uC544\uC624\uB358
      \uAE38."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109773
    m_Localized: ": \uBD84\uBA85 \uC78A\uC9C0 \uBABB\uD560 \uCD94\uC5B5\uC774\uB77C\uACE0
      \uC0DD\uAC01\uD588\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109774
    m_Localized: ": \uC774\uC0C1\uD558\uB2E4. \uC815\uC791 \uC911\uC694\uD55C \uAC8C
      \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109775
    m_Localized: ": \uB9C8\uCE58 \uC0AC\uC9C4 \uADC0\uD241\uC774\uAC00 \uCC22\uC5B4\uC9C4
      \uAC83\uCC98\uB7FC \uBA38\uB9BF\uC18D\uC774 \uD558\uC597\uAC8C \uBE44\uC5B4\uC788\uC5B4..."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109776
    m_Localized: ": \uC815\uB9D0 \uD53C\uACE4\uD55C\uB370 \uC9C0\uAE08 \uC790\uBC84\uB9AC\uBA74
      \uC548 \uB3FC..."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109777
    m_Localized: ": \uD750\uB9BF\uD574\uC9C4 \uC774 \uAE30\uC5B5\uB4E4\uC740 \uC601\uC601
      \uC0AC\uB77C\uC838 \uBC84\uB9B4 \uAC83\uB9CC \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109778
    m_Localized: ": \uD53C\uB85C\uB3C4\uAC00 \uD55C\uACC4\uC5D0 \uB2E4\uB2EC\uC73C\uBA74
      \uC7A0\uB4E4\uACE0 \uB9CC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109779
    m_Localized: ": \uD53C\uACE4\uD568\uC744 \uACAC\uB514\uACE0 \uC790\uC138\uD788
      \uAD00\uCC30\uD574\uC11C \uAE30\uC5B5\uC744 \uB418\uC0B4\uB9AC\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109780
    m_Localized: ": \uC5B4\uB9B0 \uC2DC\uC808\uC5D4 \uC774\uB7F0 \uD53C\uACE4\uD568\uC744
      \uC774\uACA8\uB0B4\uB294 \uB098\uB9CC\uC758 \uBC29\uBC95\uC774 \uC788\uC5C8\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109781
    m_Localized: ": \uCC28 \uC548 \uC5B4\uB518\uAC00\uC5D0 \uB2E8\uC11C\uAC00 \uC228\uC5B4
      \uC788\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109782
    m_Localized: ": \uD558\uB098\uB3C4 \uBE60\uC9D0\uC5C6\uC774... \uC774 \uCD94\uC5B5\uC744
      \uB418\uCC3E\uACE0 \uC2F6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109783
    m_Localized: ": \uC774\uB54C\uB3C4 \uB098\uB294 \uC544\uC8FC \uD53C\uACE4\uD588\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109784
    m_Localized: ": \uCC28 \uC548\uC5D0\uC11C \uC7A0\uB4E4\uC9C0 \uC54A\uC73C\uB824\uACE0
      \uC560\uC4F0\uB358 \uAE30\uC5B5\uC774 \uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109785
    m_Localized: "\uC544\uBE60: \uC624\uB298 \uC7AC\uBC0C\uAC8C \uB180\uC558\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109786
    m_Localized: "\uC5C4\uB9C8: \uC9D1\uAC00\uB824\uBA74 2\uC2DC\uAC04 \uB354 \uAC00\uC57C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109787
    m_Localized: "\uC5C4\uB9C8: \uC878\uB9AC\uBA74 \uC790\uB834"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109788
    m_Localized: ": \uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109789
    m_Localized: "\uC544\uBE60 : \uADF8\uB7FC \uCD9C\uBC1C\uD574 \uBCFC\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109790
    m_Localized: ": \uBD80\uBAA8\uB2D8\uC774 \uC88B\uC544\uD558\uC2DC\uB358 \uB178\uB798\uAC00
      \uB77C\uB514\uC624\uC5D0\uC11C \uD758\uB7EC\uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109791
    m_Localized: ": \uB77C\uB514\uC624 \uBC84\uD2BC\uC744 \uB2E4\uC2DC \uB204\uB974\uBA74
      \uB178\uB798\uAC00 \uBA48\uCD94\uB294\uAC70 \uAC19\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109792
    m_Localized: ": \uB2E4\uC2DC \uD0AC\uB54C\uB9C8\uB2E4 \uB2E4\uB978 \uB178\uB798\uAC00
      \uB098\uC624\uB294 \uAC74\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109793
    m_Localized: ": \uB0B4\uBD80 \uB4F1\uC774 \uCF1C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109794
    m_Localized: "\uC544\uBE60: \uB0B4\uBD80\uB4F1 \uCF1C\uC9C0\uB9C8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109795
    m_Localized: "\uC544\uBE60: \uC704\uD5D8\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109796
    m_Localized: ": \uC5B4\uB9B0 \uC2DC\uC808 \uC774\uB7F0\uC2DD\uC73C\uB85C \uC878\uC74C\uC744
      \uC774\uACA8\uB0C8\uB358\uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109797
    m_Localized: ": \uCC38 \uC7AC\uBBF8\uC788\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109798
    m_Localized: ": \uADF8\uB9CC \uC7A0\uC5D0 \uB4E4\uACE0 \uB9D0\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109799
    m_Localized: ": \uAC8C\uC784 \uC624\uBC84"
    m_Metadata:
      m_Items: []
  - m_Id: 190757109800
    m_Localized: ": \uADF8\uB550 \uADF8\uB7AC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 190757109801
    m_Localized: ": \uB0B4 \uC18C\uC911\uD55C \uCD94\uC5B5\uC744 \uC9C0\uCF1C\uB0B8\uAC83\uB9CC
      \uAC19\uB2E4"
    m_Metadata:
      m_Items: []
